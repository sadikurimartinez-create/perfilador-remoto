{
  "engine": "OSINT Dual Validation Certificate",
  "version": "1.0",
  "purpose": "Certificación de equivalencia entre OSINT Legacy y OSINT Adapter",
  "validationSchema": {
    "executionId": "unique execution identifier",
    "timestamp": "execution date",
    "legacyRecords": "records generated by legacy engine",
    "adapterRecords": "records generated by adapter",
    "difference": "result difference",
    "confidence": "average confidence score",
    "decision": "validation decision"
  },
  "decisionRules": [
    {
      "condition": "difference === 0",
      "decision": "APPROVED"
    },
    {
      "condition": "difference > 0 && confidence >= 70",
      "decision": "REVIEW_REQUIRED"
    },
    {
      "condition": "adapter failure",
      "decision": "ROLLBACK_TO_LEGACY"
    }
  ],
  "requiredEvidence": [
    "backup",
    "integrity hash",
    "audit trace",
    "provider response"
  ],
  "status": "DUAL_VALIDATION_CERTIFICATE_READY",
  "createdAt": "2026-08-09T03:01:34.069Z"
}